{
    "preset": "laravel",
    "exclude": [
        "bootstrap/cache",
        "resources/views",
        "storage"
    ],
    "rules": {
        "php_unit_method_casing": false,
        "not_operator_with_successor_space": false,
        "unary_operator_spaces": true,
        "concat_space": {
            "spacing": "one"
        }
    }
}
